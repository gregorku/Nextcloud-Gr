###############################################################################
#
# Nextcloud-Gr Project
#
# File:
#   .env.example
#
# Description:
#   Template for /docker-data/stacks/nextcloud-gr/.env.
#
#   Values that start with set_ are placeholders. check-env.sh and
#   deploy.sh reject them. Generated passwords are written only into
#   the runtime .env by update-env.sh. They are not stored in Git and
#   the scripts do not print them.
#
#   Changing NEXTCLOUD_TAG here does not upgrade a running instance.
#   update-env.sh copies the tag into .env. deploy.sh then refuses to
#   start a different tag and tells the operator to run upgrade.sh.
#
# Version pins checked on 2026-10-20. Sources are in scripts/config.sh
# and docs/architecture.md.
#
###############################################################################

###############################################################################
# Docker Compose
###############################################################################

COMPOSE_PROJECT_NAME=nextcloud-gr

###############################################################################
# Persistent paths
#
# DATA_DIR and the HTML directory live on the /docker-data Incus disk.
# POSTGRESQL_HOST_DIR and NEXTCLOUD_DATA_HOST_DIR are host paths inside
# this container. They must already be on a mounted disk. deploy.sh
# does not create missing parents on the root filesystem.
#
# NEXTCLOUD_DATA_HOST_DIR must be a directory on the HDD RAID mount, not
# the mountpoint itself, so a restore can rename it. It must not be the
# directory still used by the old Nextcloud.
#
# NEXTCLOUD_SOURCE_DATA_DIR is optional until migration. Empty is valid.
# When set, it is read by the operator during migration and is not
# mounted into the new Compose stack.
###############################################################################

DATA_DIR=/docker-data/nextcloud-gr
NEXTCLOUD_HTML_HOST_DIR=/docker-data/nextcloud-gr/html
POSTGRESQL_HOST_DIR=set_postgresql_data_dir
NEXTCLOUD_DATA_HOST_DIR=set_nextcloud_data_dir
NEXTCLOUD_SOURCE_DATA_DIR=

###############################################################################
# Public name and private backend
#
# Traefik in Infrastructure-netcup terminates HTTPS for this domain.
# NEXTCLOUD_BACKEND_BIND is the address on this Incus container that
# Traefik reaches through WireGuard. It was not observed from this
# checkout. 0.0.0.0 is not a valid value.
#
# NEXTCLOUD_BACKEND_PORT is the HTTP port of Nginx. 8080 is only a
# suggested free port. It is not a discovered assignment.
###############################################################################

NEXTCLOUD_DOMAIN=gregor.serveftp.org
NEXTCLOUD_BACKEND_BIND=set_backend_bind_address
NEXTCLOUD_BACKEND_PORT=8080
NEXTCLOUD_TRUSTED_DOMAINS=gregor.serveftp.org

###############################################################################
# Images
#
# Tags are exact patch releases. latest, stable and stable-fpm are
# rejected. nextcloud and cron both use NEXTCLOUD_IMAGE:NEXTCLOUD_TAG.
###############################################################################

NEXTCLOUD_IMAGE=docker.io/library/nextcloud
NEXTCLOUD_TAG=35.0.2-fpm
POSTGRES_IMAGE=docker.io/library/postgres:18.6
REDIS_IMAGE=docker.io/library/redis:8.10.2-alpine
NGINX_IMAGE=docker.io/library/nginx:1.30.6-alpine

###############################################################################
# Docker bridge
#
# Both values are placeholders. Pick a subnet that does not overlap
# WireGuard, the Incus LAN or another bridge on this Docker daemon.
# Compose services use DNS names, not fixed container addresses.
###############################################################################

DOCKER_NETWORK_SUBNET=172.18.0.0/24
DOCKER_NETWORK_GATEWAY=172.18.0.1

###############################################################################
# PostgreSQL
#
# One database and one unprivileged role. The password is generated.
# Port 5432 is not published.
###############################################################################

PG_DB=nextcloud
PG_USER=nextcloud
PG_PASS=set_postgres_password

###############################################################################
# Redis
#
# Cache and transactional file locking only. The password is generated.
# Port 6379 is not published.
###############################################################################

REDIS_PASSWORD=set_redis_password

###############################################################################
# First installation
#
# The admin password is used by the image entrypoint only while
# config.php does not exist. After installation the account lives in
# PostgreSQL. The username is kept once it is no longer a placeholder.
###############################################################################

NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=set_admin_password

###############################################################################
# Reverse proxy
#
# TRUSTED_PROXIES is a space-separated list of CIDR ranges. It is the
# address Nextcloud and Nginx see for Traefik, not a guess.
# The public URL is HTTPS even though Nginx itself speaks HTTP.
###############################################################################

TRUSTED_PROXIES=set_trusted_proxy_cidrs
OVERWRITEPROTOCOL=https
OVERWRITEHOST=gregor.serveftp.org
OVERWRITECLIURL=https://gregor.serveftp.org
FORWARDED_FOR_HEADERS=HTTP_X_FORWARDED_FOR

###############################################################################
# PHP limits
#
# The official image reads these variables. 16G matches the Nginx
# client_max_body_size used for large uploads.
###############################################################################

PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=16G
PHP_OPCACHE_MEMORY_CONSUMPTION=128

###############################################################################
# Logging
###############################################################################

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

###############################################################################
# Encrypted archive of the database, config, custom apps and themes
#
# BACKUP_LOCAL_DIR is the directory on /docker-data. It is not a
# backup against loss of that disk.
#
# BACKUP_EXTERNAL_DIR is used only when the path is itself a
# mountpoint and mode 700. An ordinary directory of the same name is
# refused. Empty means the age archive stays only in BACKUP_LOCAL_DIR.
#
# BACKUP_AGE_RECIPIENT is a public age recipient. Empty means backup.sh
# keeps no archive. Do not put an AGE-SECRET-KEY here.
###############################################################################

BACKUP_LOCAL_DIR=/docker-data/backups/nextcloud-gr
BACKUP_EXTERNAL_DIR=
BACKUP_AGE_RECIPIENT=

###############################################################################
# Restic repository for the Nextcloud data directory
#
# A local path is not an off-site copy. Prefer a remote scheme
# (sftp, rest, s3, rclone, azure, gs, b2 or swift). If the repository
# is local, backup.sh copies the snapshot with restic copy onto
# BACKUP_EXTERNAL_DIR/restic only when that directory is a mount on
# another device. The destination snapshot id is read from that
# repository and may differ from the source id. Copying the age
# archive alone is not a complete backup. The password is generated
# into .env. Keep an offline copy. It is not printed.
#
# Retention counts are restic forget --keep-* values.
###############################################################################

RESTIC_REPOSITORY=/docker-data/backups/nextcloud-gr/restic
RESTIC_PASSWORD=set_restic_password
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
RESTIC_KEEP_YEARLY=1

###############################################################################
# Upgrade
#
# Minimum free mebibytes required on the data, database and backup
# filesystems before upgrade.sh changes anything.
###############################################################################

UPGRADE_MIN_FREE_MB=5120

###############################################################################
# SMTP
#
# Empty SMTP_HOST leaves outgoing mail unconfigured. When SMTP_HOST is
# set, the other SMTP values are required. Configure mail either here
# or later in the Nextcloud UI, not in both places. The image overrides
# the UI while these variables are set.
###############################################################################

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_NAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_DOMAIN=
