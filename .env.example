###############################################################################
#
# Authentik-netcup Project
#
# File:
#   .env.example
#
# Description:
#   Template for the runtime file /docker-data/stacks/authentik-netcup/.env.
#
#   Values that start with "set_" are placeholders. check-env.sh and
#   deploy.sh reject them. Real passwords and the Authentik secret key
#   are generated into the runtime .env by update-env.sh and are not
#   stored in Git.
#
###############################################################################

###############################################################################
# Docker Compose
###############################################################################

COMPOSE_PROJECT_NAME=authentik-netcup

###############################################################################
# Persistent data
###############################################################################

DATA_DIR=/docker-data/authentik-netcup

###############################################################################
# Authentik Incus container
#
# Traefik in Infrastructure-netcup uses this address as the HTTP backend.
# TLS, DNS and middleware stay in Infrastructure-netcup.
###############################################################################

AUTHENTIK_HOST_IP=10.10.10.100
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_DOMAIN=auth.serveftp.org

###############################################################################
# Images
#
# Pinned to the upstream Compose file for release 2026.8:
#   https://goauthentik.io/version/2026.8/lifecycle/container/compose.yml
# Resolved tag in that file: 2026.8.3
# PostgreSQL 16 is the image pinned there. authentik supports PostgreSQL 14-18.
# Redis is not part of that Compose file (removed in authentik 2025.10).
###############################################################################

AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.8.3
POSTGRES_IMAGE=docker.io/library/postgres:16-alpine

###############################################################################
# PostgreSQL
###############################################################################

PG_DB=authentik
PG_USER=authentik
PG_PASS=set_postgres_password

###############################################################################
# Authentik
###############################################################################

AUTHENTIK_SECRET_KEY=set_authentik_secret_key
AUTHENTIK_POSTGRESQL__SSLMODE=disable
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_OUTPOSTS__DISCOVER=false

#
# Source addresses from which Traefik may send X-Forwarded-* headers.
# Setting this replaces authentik's default list. The address seen by
# the published port was not observed from this checkout, so the value
# is a placeholder until it is set in the runtime .env.
#
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=set_trusted_proxy_cidrs

###############################################################################
# Internal addresses on authentik-netcup (10.42.0.0/16)
###############################################################################

IP_POSTGRESQL=10.42.0.10
IP_AUTHENTIK_SERVER=10.42.0.20
IP_AUTHENTIK_WORKER=10.42.0.21

###############################################################################
# SMTP
#
# authentik default.yml uses localhost:25. That is not a configured
# mail server for this project. Replace the set_* values before deploy.
###############################################################################

AUTHENTIK_EMAIL__HOST=set_smtp_host
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=set_smtp_username
AUTHENTIK_EMAIL__PASSWORD=set_smtp_password
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=set_smtp_from

###############################################################################
# Logging
###############################################################################

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

###############################################################################
# Mounted host directory for the encrypted copy
#
# /backups is the Incus mount of the VPS host backup directory.
# backup.sh copies the .age archive there only when this path is
# itself a mountpoint, mode 700. An ordinary directory of the same
# name on the container root filesystem is refused.
# This is not a remote server. Another program transfers the files
# later. Empty means backup.sh keeps only BACKUP_LOCAL_DIR.
# Do not point this at DATA_DIR, STACK_DIR or GIT_DIR.
###############################################################################

BACKUP_EXTERNAL_DIR=/backups

#
# Public age recipient (age1... or an ssh public key). Empty means
# backup.sh writes no archive. Do not put an AGE-SECRET-KEY here.
# The private identity stays outside Git, the stack and the archive.
#
BACKUP_AGE_RECIPIENT=
